# Copy to server/.env and fill in. Never commit the real file.

# Set to 1 to run with generated demo data and no vendor accounts.
DEMO_MODE=0

# The Autotask and Datto values in the next two blocks are optional: leave
# one unset and it can be entered on the Settings page, where it is stored
# encrypted under the master key at the end of this file. A value set here
# always wins and is read-only in the app.

# ── Autotask PSA ────────────────────────────────────────────────────────────
# An API User in Autotask: Admin -> Resources/Users -> New API User.
# The tracking identifier is shown on the same screen as the integration code.
AUTOTASK_USERNAME=apiuser@example.com
AUTOTASK_PASSWORD=your-autotask-api-password
AUTOTASK_TRACKING_ID=your-integration-code

# Autotask assigns each tenant to a zone. The zone's API hostname is shown on
# the API user's page; put its number in place of <zone>.
AUTOTASK_BASE_URL=https://webservices<zone>.autotask.net/ATServicesRest/v1.0

# ── Datto RMM REST API ──────────────────────────────────────────────────────
# Setup -> Global Settings -> Access Control -> Enable API Access, then
# Setup -> Users -> (user) -> Generate API Keys. The secret is shown once.
DATTO_API_KEY=your-datto-api-key
DATTO_API_SECRET=your-datto-api-secret

# Your Datto regional platform: the first label of the host you sign in to,
# https://<platform>.centrastage.net. The REST API and its OAuth endpoint are
# derived from it.
DATTO_PLATFORM=your-platform

# ── Scheduled delivery ──────────────────────────────────────────────────────
# Where the Node renderer listens (docker compose sets this to the service).
RENDERER_URL=http://localhost:3100
# The HTTP POST URL of the Power Automate flow that sends the mail. Treat it
# as a password: the URL carries its own signature.
DELIVERY_WEBHOOK_URL=
# IANA zone the day-of-month and hour of a schedule are read in.
SCHEDULE_TIMEZONE=America/New_York

# ── Stored credentials ──────────────────────────────────────────────────────
# Master key that encrypts the vendor credentials entered in the app's
# Settings page and kept in the database. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave it blank and the server creates data/secret.key on first use instead;
# back that file up with the data directory, since the stored credentials
# cannot be read without it.
APP_SECRET_KEY=

# ── Deployment files that are never committed ───────────────────────────────
# server/data/tenant.json          client groups, logos, rates, picker years
# server/report_rules_local.py     picklist ids, SLA targets, tiers, fiscal month
# DATA_DIR overrides where server/data lives (the compose volume mounts /app/data).
